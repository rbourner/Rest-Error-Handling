    <userTask id="_FA72C28E-2F1C-4E73-8969-6C70FA4F3BFD" name="Fix REST Service">
      <extensionElements>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script>Integer nb = (Integer) kcontext.getVariable(&quot;nbTries&quot;);
